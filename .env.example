# Optional account + persistent world features (Supabase)
# Keep SUPABASE_SERVICE_ROLE_KEY server-side; never prefix it with VITE_ or ship it to a browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# For a Vite-only local workflow, run the API/socket server on :4100 and Vite on :5173.
# No VITE_* secrets are needed. The app talks to the same-origin /api and /socket.io proxies.
